# Set default behavior to automatically handle line endings and enforce LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.java text diff=java eol=lf
*.gradle text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.proto text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Shell scripts and wrapper scripts
/mvnw text eol=lf
/gradlew text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
